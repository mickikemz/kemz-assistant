# Copy to .env and fill in. Never commit .env.
# These are the ONLY place your real API keys live — the desktop app never sees them.

# Which LLM powers AI suggestions: "anthropic", "gemini", or "groq".
# Switching back to Claude later is just changing this one line.
AI_PROVIDER=groq

# https://console.anthropic.com/ — only needed when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# https://aistudio.google.com/apikey — free tier, no card required.
# Only needed when AI_PROVIDER=gemini. Capped at 20 requests/day on the free
# tier — fine for a quick check, not enough for a real live session.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# https://console.groq.com/keys — free tier, no card required.
# Only needed when AI_PROVIDER=groq. Fastest inference of the three options.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# https://console.deepgram.com/  — needs a key with project "manage" access,
# because the server uses it to mint short-lived per-session keys (see
# deepgram.js). This is NOT the key that ends up on end-users' machines.
DEEPGRAM_API_KEY=
# Optional: pin a specific project. If unset, the server uses your first project.
DEEPGRAM_PROJECT_ID=

# A long random string only you know. Required in the `x-admin-secret` header
# for every /admin/* request, including the admin-cli. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SECRET=

PORT=8787

# Default free minutes granted to a newly created license key.
DEFAULT_FREE_MINUTES=30
